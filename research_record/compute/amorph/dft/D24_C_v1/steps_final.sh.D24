# steps() for the DAG node FINAL, sourced by driver.sh (JOB=final): final SCF on the relaxed geometry, planar-averaged
# potential, projwfc, then the register A14/A16 export (D-24, 2026-10-11). driver.sh, qeio.py and the node scripts are
# unchanged; everything below runs on the worker with the python of the QE environment (standard library only).
#   AFS: final_results.tar.gz (driver.sh packs *.out *.in *.tmpl *.dat *.log steps.sh pdos/*) stays small: inputs, logs,
#     scf.out (verbosity 'high': occupations), the planar average, pdos_tot and the tables written here:
#     occ_kw_final.dat (eigenvalues, f_nk, k-weights), projwfc_map_final.dat (state -> atom, species, l, m),
#     projwfc_states_final.dat (per-state energy and completeness, from projwfc.out and from atomic_proj.xml),
#     pdos_species_final.dat, export_checks_final.dat, lineage_final.dat, export_manifest_final.dat and
#     projwfc_final_summary.out (projwfc.out without the per-state component lines).
#   EOS: $EXPORT_EOS/<name>/final_<ClusterId>/ with a sha256 MANIFEST: atomic_proj.xml.gz (all per-state projections),
#     data-file-schema.xml.gz, projwfc_final.out.gz, pdos_atoms.tar.gz, final_small.tar.gz (the AFS set) and, for the
#     2.0 nm cells, save_nowfc.tar.gz (charge density + XML + pseudopotentials, no wavefunctions).
#   Running jobs lose their Kerberos ticket after ~25 h (2026-10-03), so the in-job xrdcp fails on long finals. The job
#   then writes exp/EXPORT_PENDING and waits (at most EXPORT_WAIT_S, and never past the driver deadline + 1 h) for
#   common/export_pull.sh on lxplus, which copies the files through condor_ssh_to_job, checks their sha256 and answers
#   with exp/EXPORT_PULLED. Without a pull the per-atom PDOS and the full projwfc output stay in the AFS tarball;
#   atomic_proj.xml and the charge density are then lost, and export_manifest_final.dat says so.
EXPORT_EOS=${EXPORT_EOS:-/eos/user/m/melrashe/qe/exports}
EXPORT_RHO_RE=${EXPORT_RHO_RE:-_2p0(_|$)}     # run names whose save (charge density) is exported: the 2.0 nm cells
EXPORT_WAIT_S=${EXPORT_WAIT_S:-21600}
EXPORT_RETRY_SLEEP=${EXPORT_RETRY_SLEEP:-30}

steps() {
  python qeio.py newgeom final.tmpl relax.in > scf.in
  write_lineage
  NKP=1; for p in 4 3 2; do [ $((NCPU % p)) -eq 0 ] && { NKP=$p; break; }; done
  log "pools: $NKP (NCPU $NCPU)"
  export FORCE_CPU=1   # one QE version (CPU 7.5) for scf, pp.x and projwfc.x
  if ! run_pw scf $NKP || ! grep -q 'convergence has been achieved' scf.out; then
    # also catches a stop by max_seconds, after which pw.x still prints JOB DONE
    log "final SCF failed or not converged: no pp.x, projwfc.x or export"
    echo "# D-24 export: none, the final SCF did not converge (see scf.out)" > export_manifest_final.dat
    return 0
  fi
  run_ppavg slab "$JOB" 4.0
  run_pdos slab "$JOB" "$(python qeio.py fermi scf.out)" $NKP
  export_final
}

iwo_name() {   # run name from the job ad (+IWOJob = "<name>_final")
  local n
  n=$(awk -F' = ' '/^IWOJob = /{gsub(/"/, "", $2); print $2; exit}' "${_CONDOR_JOB_AD:-/dev/null}" 2>/dev/null)
  n=${n%_final}
  echo "${n:-${IWO_NAME:-unknown}}"
}

write_lineage() {   # lineage_final.dat: what this SCF was built from (register A14 "geometry lineage")
  local f
  {
    echo "# geometry lineage of the final SCF (register A14; D-24), written on the worker before pw.x"
    echo "run $(iwo_name)"
    echo "written_utc $(date -u +%FT%TZ)"
    echo "host $(hostname)"
    grep -E '^(ClusterId|ProcId|GlobalJobId|IWOJob|DAGManJobId|DAGNodeName|DAGParentNodeNames|QDate|JobCurrentStartDate|NumJobStarts) = ' \
      "${_CONDOR_JOB_AD:-/dev/null}" 2>/dev/null | sed 's/^/jobad /'
    for f in relax.in final.tmpl scf.in steps.sh driver.sh qeio.py dat2h5.py pseudo/*; do
      [ -f "$f" ] && echo "sha256 $(sha256sum "$f" | cut -c1-64) $f"
    done
    echo "# relax.in is runs/<name>/relax.in as transferred at job start, i.e. the geometry written by the last RELAX"
    echo "# segment. The segment list is not on the worker: common/lineage_relax.sh <name> (lxplus) lists the segments"
    echo "# and finds the relax_s<seg>_results.tar.gz whose relax.in has the sha256 above."
    python - relax.in scf.in <<'PY'
import re
import sys


def cards(path):
    lines = open(path).read().splitlines()
    out = {}
    for key, nrow in (('CELL_PARAMETERS', 3), ('ATOMIC_POSITIONS', 0)):
        heads = [i for i, l in enumerate(lines) if l.strip().upper().startswith(key)]
        if not heads:
            out[key] = ('', [], [])
            continue
        i = heads[-1]
        lab, val = [], []
        for l in lines[i + 1:]:
            s = l.split()
            try:
                v = [float(x) for x in (s[0:3] if nrow else s[1:4])]
            except (ValueError, IndexError):
                break
            if len(v) < 3:
                break
            lab.append('' if nrow else s[0])
            val.append(v)
            if nrow and len(val) == nrow:
                break
        unit = re.sub(r'[(){}]', ' ', lines[i]).split()[1:2]
        out[key] = (unit[0].lower() if unit else '', lab, val)
    return out


a, b = cards(sys.argv[1]), cards(sys.argv[2])
ok = True
for key in ('CELL_PARAMETERS', 'ATOMIC_POSITIONS'):
    (ua, la, va), (ub, lb, vb) = a[key], b[key]
    d = max((abs(x - y) for p, q in zip(va, vb) for x, y in zip(p, q)), default=float('nan'))
    good = ua == ub and la == lb and len(va) == len(vb) > 0 and d < 1e-8
    ok &= good
    print(f'geometry {key}: relax.in {len(va)} rows ({ua}), scf.in {len(vb)} rows ({ub}), '
          f'labels identical {la == lb}, max |diff| {d:.2e} -> {"PASS" if good else "FAIL"}')
m = re.search(r'nat\s*=\s*(\d+)', open(sys.argv[2]).read())
nat = int(m.group(1)) if m else -1
ok &= nat == len(b['ATOMIC_POSITIONS'][2])
print(f'geometry nat (scf.in &SYSTEM) {nat}, positions {len(b["ATOMIC_POSITIONS"][2])}')
print('geometry_check', 'PASS' if ok else 'FAIL')
PY
  } > lineage_final.dat 2>&1
  log "lineage: $(grep '^geometry_check' lineage_final.dat)"
}

eos_put() {   # eos_put <file> <EOS dir>: prints XRD_ADLER32 | XRD_SIZE | FUSE_SIZE | FAILED
  local f=$1 d=$2 b sz t rs
  b=$(basename "$f"); sz=$(stat -c %s "$f")
  xrdfs root://eosuser.cern.ch mkdir -p "$d" >> "${JOB}_export.log" 2>&1
  for t in 1 2; do
    if xrdcp -f -s -C adler32 "$f" "root://eosuser.cern.ch/$d/$b" >> "${JOB}_export.log" 2>&1; then echo XRD_ADLER32; return 0; fi
    sleep "$EXPORT_RETRY_SLEEP"
  done
  if xrdcp -f -s "$f" "root://eosuser.cern.ch/$d/$b" >> "${JOB}_export.log" 2>&1; then
    rs=$(xrdfs root://eosuser.cern.ch stat "$d/$b" 2>/dev/null | awk '/^Size:/{print $2}')
    if [ "$rs" = "$sz" ]; then echo XRD_SIZE; return 0; fi
  fi
  if mkdir -p "$d" 2>/dev/null && cp -f "$f" "$d/$b" 2>/dev/null && [ "$(stat -c %s "$d/$b" 2>/dev/null)" = "$sz" ]; then
    echo FUSE_SIZE; return 0
  fi
  echo FAILED; return 1
}

export_final() {
  local name dest sv=tmp/slab.save f sz sh st wait_s t_end
  local -a small fails=()
  name=$(iwo_name); dest="$EXPORT_EOS/$name/final_${CLUSTER:-0}"
  mkdir -p exp
  rm -f "$sv"/wfc*.dat "$sv"/wfc*.hdf5   # wavefunctions are not exported; pp.x and projwfc.x are done: free the disk
  log "export $name: tables"
  export_tables "$sv" "$JOB" >> "${JOB}_export.log" 2>&1 || log "export tables: python error (see ${JOB}_export.log)"
  [ -f "projwfc_${JOB}.out" ] && grep -v '\*\[#' "projwfc_${JOB}.out" > "projwfc_${JOB}_summary.out"
  [ -f "$sv/atomic_proj.xml" ] && gzip -c "$sv/atomic_proj.xml" > exp/atomic_proj.xml.gz
  [ -f "$sv/data-file-schema.xml" ] && gzip -c "$sv/data-file-schema.xml" > exp/data-file-schema.xml.gz
  [ -f "projwfc_${JOB}.out" ] && gzip -c "projwfc_${JOB}.out" > "exp/projwfc_${JOB}.out.gz"
  compgen -G 'pdos/*pdos_atm*' > /dev/null && tar czf exp/pdos_atoms.tar.gz pdos/*pdos_atm*
  if [[ $name =~ $EXPORT_RHO_RE ]]; then
    tar czf exp/save_nowfc.tar.gz -C tmp --exclude='wfc*' --exclude=atomic_proj.xml slab.save
  fi
  shopt -s nullglob
  small=( *.out *.in *.tmpl *.dat *.log steps.sh pdos/*pdos_tot )
  shopt -u nullglob
  tar czf exp/final_small.tar.gz --exclude="projwfc_${JOB}.out" "${small[@]}"
  {
    echo "# eos_dest $dest"
    echo "# run $name cluster ${CLUSTER:-0} written_utc $(date -u +%FT%TZ)"
    for f in exp/*; do
      case $f in exp/MANIFEST|exp/EXPORT_*) continue;; esac
      echo "$(basename "$f") $(stat -c %s "$f") $(sha256sum "$f" | cut -c1-64)"
    done
  } > exp/MANIFEST
  log "export $name: $(grep -vc '^#' exp/MANIFEST) files, $(du -sh exp | cut -f1) -> $dest"
  : > exp/STATUS
  while read -r f sz sh; do
    st=$(eos_put "exp/$f" "$dest")
    echo "$f $sz $sh $st" >> exp/STATUS
    [ "$st" = FAILED ] && fails+=("$f")
  done < <(grep -v '^#' exp/MANIFEST)
  if [ ${#fails[@]} -gt 0 ]; then
    printf '%s\n' "${fails[@]}" > exp/EXPORT_PENDING
    wait_s=$(( DEADLINE + 3600 - $(date +%s) )); [ "$wait_s" -gt "$EXPORT_WAIT_S" ] && wait_s=$EXPORT_WAIT_S
    log "export: ${#fails[@]} file(s) not copied in-job; waiting up to ${wait_s}s for export_pull.sh (exp/EXPORT_PENDING)"
    t_end=$(( $(date +%s) + wait_s ))
    while [ "$(date +%s)" -lt "$t_end" ] && [ ! -f exp/EXPORT_PULLED ]; do sleep 60; done
    for f in "${fails[@]}"; do
      grep -qx "$f" exp/EXPORT_PULLED 2>/dev/null && sed -i "s/^\($f .*\) FAILED\$/\1 PULLED/" exp/STATUS
    done
  fi
  # what is safely on EOS no longer needs to travel back to AFS
  grep -q '^pdos_atoms.tar.gz .* \(XRD\|FUSE\|PULLED\)' exp/STATUS && rm -f pdos/*pdos_atm*
  grep -q "^projwfc_${JOB}.out.gz .* \(XRD\|FUSE\|PULLED\)" exp/STATUS && rm -f "projwfc_${JOB}.out"
  {
    echo "# D-24 export of $name (cluster ${CLUSTER:-0}), $(date -u +%FT%TZ); EOS directory $dest"
    echo "# status: XRD_ADLER32 / XRD_SIZE / FUSE_SIZE = copied in-job; PULLED = copied by export_pull.sh (sha256 checked);"
    echo "# FAILED = not on EOS (per-atom PDOS and the full projwfc output then stay in this tarball)"
    echo "# file bytes sha256 status"
    cat exp/STATUS
  } > export_manifest_final.dat
  if grep -q ' FAILED$' exp/STATUS; then log "export INCOMPLETE: $(grep -c ' FAILED$' exp/STATUS) file(s) not on EOS"
  else log "export complete: $(wc -l < exp/STATUS) files on EOS"; fi
  [ -f exp/EXPORT_PULLED ] || eos_put export_manifest_final.dat "$dest" > /dev/null 2>&1
}

export_tables() {   # export_tables <save dir> <job>: the small AFS tables and export_checks_final.dat
  python - "$1" "$2" <<'PY'
import glob
import os
import re
import sys
import xml.etree.ElementTree as ET

sv, job = sys.argv[1], sys.argv[2]
HA = 27.211386245988          # eV per Hartree (the QE 7.5 value)
chk = []

# 1. eigenvalues, occupations and k-weights: data-file-schema.xml of the final SCF
root = ET.parse(os.path.join(sv, 'data-file-schema.xml')).getroot()
bs = root.find('output/band_structure')
lsda = (bs.findtext('lsda') or 'false').strip() == 'true'
nbnd = int(bs.findtext('nbnd') or bs.findtext('nbnd_up'))
nelec = float(bs.findtext('nelec'))
ef = bs.findtext('fermi_energy')
ef_ev = float(ef) * HA if ef else float('nan')
sm = root.find('input/bands/smearing')
smear = sm.text.strip() if sm is not None else 'none'
degauss_ry = 2 * float(sm.get('degauss')) if sm is not None and sm.get('degauss') else 0.0
kinfo, rows = [], []
for ik, ks in enumerate(bs.findall('ks_energies'), 1):
    kp = ks.find('k_point')
    w = float(kp.get('weight'))
    e = [float(x) * HA for x in ks.findtext('eigenvalues').split()]
    f = [float(x) for x in ks.findtext('occupations').split()]
    kinfo.append((ik, [float(x) for x in kp.text.split()], w, ks.findtext('npw', '').strip()))
    rows += [(ik, n, en, fn) for n, (en, fn) in enumerate(zip(e, f), 1)]
sw = sum(k[2] for k in kinfo)
wscale = (1.0 if lsda else 2.0) / sw          # normalised k-weight including the spin factor 2 (register A16)
wk = {k[0]: k[2] * wscale for k in kinfo}
sfw = sum(fn * wk[ik] for ik, n, en, fn in rows)
with open(f'occ_kw_{job}.dat', 'w') as o:
    o.write(f'# eigenvalues, occupations and k-weights of the final SCF (tmp/slab.save/data-file-schema.xml, QE)\n'
            f'# nelec {nelec:.4f}  nbnd {nbnd}  nks {len(kinfo)}  lsda {lsda}  fermi_energy_eV {ef_ev:.6f}  '
            f'smearing {smear}  degauss_Ry {degauss_ry:.6g}\n'
            f'# w_k = normalised k-weight including the spin factor 2 (raw XML weights sum to {sw:.6f}); f_nk in [0,1] is\n'
            f"# QE's own occupation for this smearing; check: sum_nk f_nk w_k = {sfw:.6f} (nelec {nelec:.4f})\n")
    for ik, kv, w, npw in kinfo:
        o.write(f'# k {ik} {kv[0]:.10f} {kv[1]:.10f} {kv[2]:.10f} (cartesian, 2pi/alat)  w_k {wk[ik]:.10f}  npw {npw}\n')
    o.write('# ik ibnd e_eV f_nk w_k\n')
    for ik, n, en, fn in rows:
        o.write(f'{ik} {n} {en:.6f} {fn:.10f} {wk[ik]:.10f}\n')
chk += [f'xml_nks {len(kinfo)}', f'xml_nbnd {nbnd}', f'xml_nelec {nelec:.4f}', f'xml_fermi_eV {ef_ev:.6f}',
        f'xml_smearing {smear} {degauss_ry:.6g} Ry', f'xml_sum_wk_raw {sw:.6f}', f'sum_f_w {sfw:.6f}',
        f'electron_count_check {"PASS" if abs(sfw - nelec) < 0.02 else "FAIL"}']

# 2. projwfc output: atom/orbital map and per-state energy and completeness |psi|^2
re_map = re.compile(r'state #\s*(\d+):\s*atom\s+(\d+)\s*\(\s*(\S+?)\s*\)\s*,\s*wfc\s+(\d+)\s*\(l=\s*(\d+)\s+m=\s*(-?\d+)\)')
re_k = re.compile(r'^\s*k =\s+(-?[\d.]+)\s+(-?[\d.]+)\s+(-?[\d.]+)')
re_e = re.compile(r'==== e\(\s*(\d+)\) =\s+(-?[\d.]+) eV')
re_p = re.compile(r'\|psi\|\^2 = ([\d.]+)')
pmap, states, ik, cur = [], [], 0, None
pw_out = f'projwfc_{job}.out'
if os.path.exists(pw_out):
    for line in open(pw_out):
        m = re_map.search(line)
        if m:
            pmap.append(m.groups())
            continue
        if re_k.match(line):
            ik += 1
            continue
        m = re_e.search(line)
        if m:
            cur = [ik, int(m.group(1)), float(m.group(2)), float('nan'), float('nan')]
            states.append(cur)
            continue
        m = re_p.search(line)
        if m and cur is not None:
            cur[3] = float(m.group(1))
with open(f'projwfc_map_{job}.dat', 'w') as o:
    o.write('# projwfc atomic states (index in atomic_proj.xml ATOMIC_WFC): state atom species wfc l m\n')
    o.writelines(' '.join(g) + '\n' for g in pmap)
chk += [f'projwfc_map_states {len(pmap)}', f'projwfc_k {ik}', f'projwfc_states {len(states)}']

# 3. atomic_proj.xml (streamed): counts, and the completeness sum_i |<phi_i|psi_nk>|^2 for every state
ap = os.path.join(sv, 'atomic_proj.xml')
comp, hdr, nk_ap, nwfc_ap, ne_ap = {}, {}, 0, set(), set()
if os.path.exists(ap):
    acc, nw = None, 0
    for ev, el in ET.iterparse(ap, events=('start', 'end')):
        if ev == 'start':
            if el.tag == 'HEADER':
                hdr = dict(el.attrib)
            elif el.tag == 'PROJS':
                acc, nw = None, 0
            continue
        if el.tag == 'K-POINT':
            nk_ap += 1
        elif el.tag == 'E':
            ne_ap.add(len(el.text.split()))
            el.clear()
        elif el.tag == 'ATOMIC_WFC':
            v = [float(x) for x in el.text.split()]
            if acc is None:
                acc = [0.0] * (len(v) // 2)
            for n in range(len(acc)):
                acc[n] += v[2 * n] ** 2 + v[2 * n + 1] ** 2
            nw += 1
            el.clear()
        elif el.tag == 'PROJS':
            nwfc_ap.add(nw)
            for n, c in enumerate(acc or [], 1):
                comp[(nk_ap, n)] = c
            el.clear()
    chk += ['atomic_proj_header ' + ' '.join(f'{k}={v}' for k, v in hdr.items()),
            f'atomic_proj_k {nk_ap}', f'atomic_proj_bands {sorted(ne_ap)}', f'atomic_proj_wfc {sorted(nwfc_ap)}']
else:
    chk.append('atomic_proj MISSING')
dmax, nlow, cmin = 0.0, 0, 9.0
for s in states:
    s[4] = comp.get((s[0], s[1]), float('nan'))
    if s[4] == s[4] and s[3] == s[3]:
        dmax = max(dmax, abs(s[4] - s[3]))
    c = s[4] if s[4] == s[4] else s[3]
    cmin, nlow = min(cmin, c), nlow + (c < 0.90)
with open(f'projwfc_states_{job}.dat', 'w') as o:
    o.write('# per-state completeness (1 - spilling): ik ibnd e_eV psi2_projwfc(3 dp) psi2_atomic_proj\n')
    o.writelines(f'{a} {b} {e:.5f} {p:.3f} {c:.6f}\n' for a, b, e, p, c in states)
consistent = (len(states) == nk_ap * nbnd and set(ne_ap) == {nbnd} and nwfc_ap == {len(pmap)} and len(comp) == len(states)
              and ik == nk_ap == len(kinfo) and dmax <= 0.0006)
chk += [f'max_abs_psi2_projwfc_vs_atomic_proj {dmax:.6f}', f'min_completeness {cmin:.4f}',
        f'states_completeness_below_0.90 {nlow}', f'projection_consistency {"PASS" if consistent else "FAIL"}']

# 4. PDOS summed per species and atomic shell (the per-atom files go to EOS)
re_f = re.compile(r'pdos_atm#(\d+)\((\w+)\)_wfc#(\d+)\((\w)\)$')
sums, egrid, natm = {}, None, set()
for fn in sorted(glob.glob(f'pdos/{job}.pdos_atm#*')):
    m = re_f.search(fn)
    if not m:
        continue
    natm.add(int(m.group(1)))
    data = [l.split() for l in open(fn) if l.strip() and not l.startswith('#')]
    if egrid is None:
        egrid = [r[0] for r in data]
    s = sums.setdefault(f'{m.group(2)}_wfc{m.group(3)}_{m.group(4)}', [0.0] * len(data))
    for i, r in enumerate(data):
        s[i] += float(r[1])
if egrid:
    keys = sorted(sums)
    with open(f'pdos_species_{job}.dat', 'w') as o:
        o.write('# PDOS (ldos, states/eV) summed over the atoms of each species, per atomic shell; E_eV ' + ' '.join(keys) + '\n')
        o.writelines(egrid[i] + ' ' + ' '.join(f'{sums[k][i]:.6e}' for k in keys) + '\n' for i in range(len(egrid)))
chk += [f'pdos_atoms {len(natm)}', f'pdos_species_columns {len(sums)}']
with open(f'export_checks_{job}.dat', 'w') as o:
    o.write('# D-24 export checks (written on the worker)\n')
    o.writelines(c + '\n' for c in chk)
print('\n'.join(chk))
PY
}
