# ML structure generation (MACE melt-quench), one GPU job per line of ml_jobs_r4.txt
universe                = vanilla
executable              = ml_driver.sh
arguments               = $(name)
should_transfer_files   = YES
transfer_input_files    = mace_amorph.py, specs/spec_$(name).json
when_to_transfer_output = ON_EXIT
transfer_output_files   = $(name)_ml.tar.gz
output                  = logs/$(name).$(ClusterId).out
error                   = logs/$(name).$(ClusterId).err
log                     = logs/ml.$(ClusterId).log
request_cpus            = 4
request_memory          = 16 GB
request_disk            = 20 GB
request_gpus            = 1
requirements            = regexp("A100|H100|H200", TARGET.GPUs_DeviceName)
+JobFlavour             = "workday"
+IWOJob                 = "$(name)"
queue name from ml_jobs_r4.txt
