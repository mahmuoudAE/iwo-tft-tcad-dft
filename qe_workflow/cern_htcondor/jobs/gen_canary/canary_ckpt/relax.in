&CONTROL
  calculation = 'relax', prefix = 'rel', outdir = './tmp', pseudo_dir = './'
  verbosity = 'low', tprnfor = .true., tstress = .true., max_seconds = 1.0d8
  nstep = 300, etot_conv_thr = 1.0d-4, forc_conv_thr = 1.0d-3
/
&SYSTEM
  ibrav = 0, nat = 2, ntyp = 1, ecutwfc = 40, ecutrho = 320
  occupations = 'smearing', smearing = 'mv', degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-6, mixing_beta = 0.3, electron_maxstep = 100
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  W 183.84 W.pbe-spn-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  3.1700000000 0.0000000000 0.0000000000
  0.0000000000 3.1700000000 0.0000000000
  0.0000000000 0.0000000000 3.1700000000
ATOMIC_POSITIONS crystal
  W   0.0000000000 0.0000000000 0.0000000000
  W   0.5157728707 0.5000000000 0.5000000000
K_POINTS automatic
  4 4 4 0 0 0
