&CONTROL
  calculation = 'vc-relax', prefix = 'vcr', outdir = './tmp', pseudo_dir = './'
  verbosity = 'low', tprnfor = .true., tstress = .true., max_seconds = 1.0d8
  nstep = 3, etot_conv_thr = 1.0d-4, forc_conv_thr = 1.0d-3
/
&SYSTEM
  ibrav = 0, nat = 3, ntyp = 1, ecutwfc = 40, ecutrho = 320
  occupations = 'smearing', smearing = 'mv', degauss = 0.02
  nbnd = 29
/
&ELECTRONS
  conv_thr = 1.0d-6, mixing_beta = 0.2, electron_maxstep = 150, mixing_mode = 'local-TF'
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs', cell_dofree = '2Dxy', press_conv_thr = 0.5
/
ATOMIC_SPECIES
  W 183.84 W.pbe-spn-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  3.0251964160 0.0000000000 0.0000000000
  0.0000000000 3.0251964160 0.0000000000
  0.0000000000 0.0000000000 11.1700000000
ATOMIC_POSITIONS crystal
  W                0.0000000000        0.0000000000        0.3618412079
  W                0.5000000000        0.5000000000        0.5020548064
  W                0.0000000000        0.0000000000        0.6405802613
K_POINTS automatic
  6 6 1 0 0 0
