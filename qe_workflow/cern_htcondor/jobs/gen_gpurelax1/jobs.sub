# HTCondor submit file for the CERN stage of the IWO / In2O3 DFT study (one job per line of jobs.txt)
universe                = vanilla
executable              = driver.sh
arguments               = $(job) $(limit)
should_transfer_files   = YES
transfer_input_files    = qeio.py, $(job)/, pseudo/
when_to_transfer_output = ON_EXIT
transfer_output_files   = $(job)_results.tar.gz
output                  = logs/$(job).$(ClusterId).out
error                   = logs/$(job).$(ClusterId).err
log                     = logs/$(job).$(ClusterId).log
request_cpus            = $(ncpu)
request_memory          = $(mem)
request_disk            = $(disk)
request_gpus            = $(gpus)
+JobFlavour             = "$(flavour)"
+IWOJob                 = "$(job)"
queue job, ncpu, mem, disk, flavour, limit, gpus from jobs.txt
