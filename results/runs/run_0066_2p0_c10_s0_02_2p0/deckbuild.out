ATLAS> # USER.DEFAULT=silicon is only the parser template; every relevant parameter is overridden above.
ATLAS> material material=IWO user.group=semiconductor user.default=silicon  eg300=3.37725 affinity=4.01839 permittivity=9.3  nc300=1.373e+19 nv300=1e+19  mun=12.977 mup=0.01  taun0=1e-06 taup0=1e-06 tmun=0
ATLAS> # Region 3 = Al2O3 (2 nm), eps 9.0 (ASSUMED (not reported)); region 4 = HfO2 (15 nm), eps 19.57 (MEASURED_TARGET_DEVICE (SI Fig.S1)).
ATLAS> # Set explicitly for the named materials too: ATLAS built-in permittivity defaults are NOT the measured values.
ATLAS> material region=3 permittivity=9.0
ATLAS> material region=4 permittivity=19.57
ATLAS> # [T] OPTION gate tunnelling (qtnlsc, oxide set "worst"): ASSUMED leakage-maximising scenario (optimistic, not a rigorous upper bound: no pinholes, thinning or defects); F.AE/F.BE CALCULATED (phi 1.5 eV, m 0.10; HfO2-barrier A, B transferred to the Al2O3/IWO-segment field: A/r^2, r B, r = 2.1744)
ATLAS> material region=3 affinity=1.6 eg300=8.8 me.tunnel=0.3
ATLAS> material region=4 affinity=3.2 eg300=5.8 me.tunnel=0.1
ATLAS> contact name=gate workfunction=4.7 qtunn.cmass=1
ATLAS> models fermi srh temp=300 print qtnlsc.el qtnl.derivs
