#==============================================================================
# IWO (~2 at.% W:In2O3) FET, channel t = 2.0 nm  --  IWO_PHYSICS_CONSTRAINED_MODEL_V1
# Generated by scripts/build_iwo_decks.py from config/iwo_material_model.yaml (ONE material model for all
# thicknesses). Reduced electrical deck: ideal TiN gate / Pd S/D boundaries (equipotential metals, DC).
# MESH WIDTH = 1 um -> currents are A/um. Total 290-um device current = 290 x logged current. Never divide by 290.
# Cox = 8.9554e-07 F/cm^2 (HfO2 15 nm eps 19.57 + Al2O3 2 nm eps 9.0). Vd = 0.7 V, T = 300.0 K.
# Category labels: A intrinsic, B confinement, D bulk defects, E interface, F transport, G contacts, H numerical.
#==============================================================================
# [A] Eg_bulk = 3.05 eV | LITERATURE_IWO | Fan2021_Nanomaterials Sec.3 (different sputtered IWO device)
# [B] dEg_QC(t) = 0.3533 eV | DFT_PURE_IN2O3_PROXY | a*t^-p, a=0.9205, p=1.3815 (Lin2022 slabs, Si2021)
# [A+B] EG300 = 3.4033 eV | CALCULATED | Eg_bulk + dEg_QC(t)
# [A] chi_bulk = 4.3 eV | LITERATURE_IWO | Fan2021_Nanomaterials Sec.3 (composition-mixing estimate)
# [A+B] AFFINITY = 3.9467 eV | CALCULATED | chi_bulk - dEc(t), dEc = dEg (Ev unchanged, Si2021)
# [A+B] m* = 0.2573 m0 | MEASURED_RELATED_MATERIAL + DFT_PURE_IN2O3_PROXY increment | Stokey2021 bulk 0.208 + Lin2022 PBE increment
# [A+B] NC300 = 3.2744e+18 cm^-3 | CALCULATED | 2(2 pi m* kT/h^2)^1.5; effective continuum DOS at 2 nm
# [A] NV300 = 1.000e+19 cm^-3 | ASSUMED | holes not solved
# [A] PERMITTIVITY = 9.3 - | MEASURED_TARGET_DEVICE | Januar2026 SI Fig.S1 (C-V, IWO 9.30+/-0.04; not bundled, recorded by Astra)
# [D] Nt(t) = 2.0000e+19 cm^-3 | FITTED (anchor from real-ATLAS 2 nm fit: NTA*WTA) consistent with LITERATURE_IWO trend (Januar: ~4x from 13.2 to 2 nm; 5.3e19 at 2 nm with theta_t convention) | Nt2*(2/t)^alpha, Nt2=2e+19, alpha=0.75
# [D] NTA = Nt/WTA = 5.0000e+20 cm^-3/eV | CALCULATED | gTA(E)=NTA exp((E-Ec)/WTA); integral = NTA*WTA*(1-exp(-Eg/WTA))
# [D] WTA (kTt) = 0.04 eV | FITTED, shared across thickness | Tt = 464 K; shared across thickness
# [D] deep acceptor Gaussian = 5e+16 at Ec-0.6 eV, W=0.15 cm^-3/eV | ASSUMED (insensitive; Fan2021 range 2.5-3.7e16 for a different device) | 
# [D] Nd_eff(t) = 2.5002e+17 cm^-3 | FITTED law (effective electrically active background donor density, NOT W concentration) | Nd0*(1+(t/tc)^k), Nd0=2.5e+17, tc=20.0 nm, k=4.0; NOT W concentration
# [E] interface acceptor sheet = 3e+11 at Ec-0.3 eV, W=0.12 eV cm^-2/eV | ASSUMED, shared across thickness; literature Dit(HfO2/In2O3) ~6e11 cm^-2/eV (LITERATURE_IN2O3_PROXY; here IWO/Al2O3) | regularized 0.25 nm IWO layer at the Al2O3 interface: volume amplitude = sheet peak / 0.25 nm (numerically verified: layer /2 changes Id by 0.009 dec)
# [E] Qf = 1.7300e+12 cm^-2 | FITTED single shared value (stage 3); classified as effective electrostatic correction | dVfb = -q Qf/Cox = -0.3095 V
# [F] mu_band(t) = 18.13 cm^2/Vs | FITTED per thickness | FITTED per thickness (no defensible law; sigmoidal trend attributed to percolation/crystallinity, hypothesis)
# [F] roughness factor = 0.7336 - | LITERATURE_IWO (Januar2026 Fig.5f, 2.87 A) | (1 - Dsr/t)^2, Dsr = 0.287 nm
# [F] MUN = mu_band*(1-Dsr/t)^2 = 13.3000 cm^2/Vs | CALCULATED | NOT inserted natively: ATLAS 5.28.1.R ignores MOBILITY updates between SOLVEs (Claude run_0008); the free/trapped partition of Eq.(5) is produced self-consistently by the DOS occupancy; the Ando roll-off theta_r*Vov is an approximation gap (see LIMITATIONS)
# [G] gate work function = 4.7 eV | ASSUMED (TiN 4.5-4.9 eV literature range); degenerate with Qf and chi -> held fixed | 
# [G] S/D = ideal Ohmic (no workfunction)  | ASSUMED; underconstrained (no TLM); CNL above Ec in In2O3 supports low-barrier contacts (Si2021/Lin2022) | 
# [H] capture cross sections = 1e-15 cm^2 | ASSUMED | not identifiable from DC transfer curves
#==============================================================================
go atlas
mesh width=1.0
x.mesh loc=0 spac=0.3
x.mesh loc=1.8 spac=0.05
x.mesh loc=2 spac=0.01
x.mesh loc=2.2 spac=0.05
x.mesh loc=3 spac=0.2
x.mesh loc=12 spac=0.7
x.mesh loc=21 spac=0.2
x.mesh loc=21.8 spac=0.05
x.mesh loc=22 spac=0.01
x.mesh loc=22.2 spac=0.05
x.mesh loc=24 spac=0.3
y.mesh loc=-0.002 spac=0.00025
y.mesh loc=-0.00025 spac=6.25e-05
y.mesh loc=-0.000125 spac=6.25e-05
y.mesh loc=0 spac=6.25e-05
y.mesh loc=0.002 spac=0.00025
y.mesh loc=0.017 spac=0.001
region num=1 user.material=IWO x.min=0 x.max=24 y.min=-0.002 y.max=-0.00025
region num=2 user.material=IWO x.min=0 x.max=24 y.min=-0.00025 y.max=0
region num=3 material=oxide x.min=0 x.max=24 y.min=0 y.max=0.002
region num=4 material=oxide x.min=0 x.max=24 y.min=0.002 y.max=0.017
electrode name=source x.min=0 x.max=2 y.min=-0.002 y.max=-0.002
electrode name=drain x.min=22 x.max=24 y.min=-0.002 y.max=-0.002
electrode name=gate x.min=0 x.max=24 y.min=0.017 y.max=0.017
doping uniform n.type conc=2.50025e+17 region=1
doping uniform n.type conc=2.50025e+17 region=2
# USER.DEFAULT=silicon is only the parser template; every relevant parameter is overridden above.
material material=IWO user.group=semiconductor user.default=silicon \
 eg300=3.40331 affinity=3.94669 permittivity=9.3 \
 nc300=3.27444e+18 nv300=1e+19 \
 mun=13.3 mup=0.01 \
 taun0=1e-06 taup0=1e-06
material region=3 permittivity=9.0
material region=4 permittivity=19.57
contact name=gate workfunction=4.7
models fermi srh temp=300 print
# Region 1: continuous DOS. NTA cm^-3/eV at Ec (tail intercept), WTA eV; NGA/NGD Gaussian amplitudes cm^-3/eV;
#   EGA measured from Ec, EGD measured from Ev (installed manual, DEFECTS statement).
defects region=1 continuous numa=96 numd=48 \
 nta=5e+20 wta=0.04 ntd=0 wtd=0.1 \
 nga=5e+16 ega=0.6 wga=0.15 \
 ngd=0 egd=3.30331 wgd=0.1 \
 sigtae=1e-15 sigtah=1e-15 sigtde=1e-15 sigtdh=1e-15 \
 siggae=1e-15 siggah=1e-15 siggde=1e-15 siggdh=1e-15 \
 afile=acceptor_r1.dat dfile=donor_r1.dat
# Region 2: continuous DOS. NTA cm^-3/eV at Ec (tail intercept), WTA eV; NGA/NGD Gaussian amplitudes cm^-3/eV;
#   EGA measured from Ec, EGD measured from Ev (installed manual, DEFECTS statement).  Interface sheet regularized: NGA = sheet peak / layer thickness.
defects region=2 continuous numa=96 numd=48 \
 nta=5e+20 wta=0.04 ntd=0 wtd=0.1 \
 nga=1.16757e+19 ega=0.301554 wga=0.123975 \
 ngd=0 egd=3.30331 wgd=0.1 \
 sigtae=1e-15 sigtah=1e-15 sigtde=1e-15 sigtdh=1e-15 \
 siggae=1e-15 siggah=1e-15 siggde=1e-15 siggdh=1e-15 \
 afile=acceptor_r2.dat dfile=donor_r2.dat
interface qf=1.73e+12 x.min=0 x.max=24 y.min=-0.0000001 y.max=0.0000001
# Strict acceptance (XANDRNORM, cr.toler 1e-17) up to Vg = 0.7 V; default acceptance above.
method newton trap maxtraps=10 itlimit=80 climit=1e-6 ir.tol=1e-19 \
 cr.toler=1e-17 xandrnorm carriers=1 electrons
output con.band val.band e.mobility
# Interior probes (channel centre) for mobility / free-electron exports vs Vg (native solver quantities).
probe name=chan_mob x=12 y=-0.001 n.mob dir=0
probe name=chan_n x=12 y=-0.001 n.conc
probe name=avg_n region=1 average n.conc x.min=2 x.max=22 y.min=-0.002 y.max=-0.00025
solve init
save outf=equilibrium.str
solve vgate=-0.1
solve vgate=-0.2
solve vgate=-0.3
solve vgate=-0.4
solve vgate=-0.5
solve vgate=-0.6
solve vgate=-0.7
solve vgate=-0.8
solve vgate=-0.9
solve vgate=-1
solve vgate=-1.1
solve vgate=-1.2
solve vgate=-1.3
solve vgate=-1.4
solve vgate=-1.5
solve vgate=-1.6
solve vgate=-1.7
solve vgate=-1.8
solve vgate=-1.9
solve vgate=-2
solve vgate=-2.1
solve vgate=-2.2
solve vgate=-2.3
solve vgate=-2.4
solve vgate=-2.5
solve vgate=-2.6
solve vgate=-2.7
solve vgate=-2.8
solve vgate=-2.9
solve vgate=-3
solve vdrain=0.1
solve vdrain=0.2
solve vdrain=0.3
solve vdrain=0.4
solve vdrain=0.5
solve vdrain=0.6
solve vdrain=0.7
log outf=transfer.log
solve vgate=-3
solve vgate=-2.95
solve vgate=-2.9
solve vgate=-2.85
solve vgate=-2.8
solve vgate=-2.75
solve vgate=-2.7
solve vgate=-2.65
solve vgate=-2.6
solve vgate=-2.55
solve vgate=-2.5
solve vgate=-2.45
solve vgate=-2.4
solve vgate=-2.35
solve vgate=-2.3
solve vgate=-2.25
solve vgate=-2.2
solve vgate=-2.15
solve vgate=-2.1
solve vgate=-2.05
solve vgate=-2
solve vgate=-1.95
solve vgate=-1.9
solve vgate=-1.85
solve vgate=-1.8
solve vgate=-1.75
solve vgate=-1.7
solve vgate=-1.65
solve vgate=-1.6
solve vgate=-1.55
solve vgate=-1.5
solve vgate=-1.45
solve vgate=-1.4
solve vgate=-1.35
solve vgate=-1.3
solve vgate=-1.25
solve vgate=-1.2
solve vgate=-1.15
solve vgate=-1.1
solve vgate=-1.05
solve vgate=-1
solve vgate=-0.95
solve vgate=-0.9
solve vgate=-0.85
solve vgate=-0.8
solve vgate=-0.75
solve vgate=-0.7
solve vgate=-0.65
solve vgate=-0.6
solve vgate=-0.55
solve vgate=-0.5
solve vgate=-0.45
solve vgate=-0.4
solve vgate=-0.35
solve vgate=-0.3
solve vgate=-0.25
solve vgate=-0.2
solve vgate=-0.15
solve vgate=-0.1
solve vgate=-0.05
solve vgate=0
solve vgate=0.05
solve vgate=0.1
solve vgate=0.15
solve vgate=0.2
solve vgate=0.25
solve vgate=0.3
solve vgate=0.35
solve vgate=0.4
solve vgate=0.45
solve vgate=0.5
solve vgate=0.55
solve vgate=0.6
solve vgate=0.65
# On-state: default convergence acceptance.
method newton trap maxtraps=10 itlimit=80 climit=1e-6 ir.tol=1e-19 \
 cr.toler=5e-18 ^xandrnorm carriers=1 electrons
solve vgate=0.7
save outf=near_vth.str
solve vgate=0.75
solve vgate=0.8
solve vgate=0.85
solve vgate=0.9
solve vgate=0.95
solve vgate=1
solve vgate=1.05
solve vgate=1.1
solve vgate=1.15
solve vgate=1.2
solve vgate=1.25
solve vgate=1.3
solve vgate=1.35
solve vgate=1.4
solve vgate=1.45
solve vgate=1.5
solve vgate=1.55
solve vgate=1.6
solve vgate=1.65
solve vgate=1.7
solve vgate=1.75
solve vgate=1.8
solve vgate=1.85
solve vgate=1.9
solve vgate=1.95
solve vgate=2
solve vgate=2.05
solve vgate=2.1
solve vgate=2.15
solve vgate=2.2
solve vgate=2.25
solve vgate=2.3
solve vgate=2.35
solve vgate=2.4
solve vgate=2.45
solve vgate=2.5
solve vgate=2.55
solve vgate=2.6
solve vgate=2.65
solve vgate=2.7
solve vgate=2.75
solve vgate=2.8
solve vgate=2.85
solve vgate=2.9
solve vgate=2.95
solve vgate=3
log off
save outf=final.str
output con.band val.band qfn e.mobility
extract init infile="transfer.log"
extract name="IdVg" curve(v."gate",i."drain") outfile="idvg.dat"
extract name="IgVg" curve(v."gate",i."gate") outfile="igvg.dat"
extract name="IsVg" curve(v."gate",i."source") outfile="isvg.dat"
extract name="mob_vg" curve(v."gate",probe."chan_mob") outfile="chan_mobility_vg.dat"
extract name="n_vg" curve(v."gate",probe."chan_n") outfile="chan_electrons_vg.dat"
extract name="navg_vg" curve(v."gate",probe."avg_n") outfile="avg_electrons_vg.dat"
extract init infile="equilibrium.str"
extract name="cb_eq" curve(depth, impurity="Conduction Band Energy" material="All" mat.occno=1 x.val=12) outfile="cb_eq.dat"
extract name="vb_eq" curve(depth, impurity="Valence Band Energy" material="All" mat.occno=1 x.val=12) outfile="vb_eq.dat"
extract name="n_eq" curve(depth, impurity="Electron Conc" material="All" mat.occno=1 x.val=12) outfile="n_eq.dat"
extract name="qfn_eq" curve(depth, impurity="Electron QFL" material="All" mat.occno=1 x.val=12) outfile="qfn_eq.dat"
extract init infile="near_vth.str"
extract name="cb_vth" curve(depth, impurity="Conduction Band Energy" material="All" mat.occno=1 x.val=12) outfile="cb_vth.dat"
extract name="vb_vth" curve(depth, impurity="Valence Band Energy" material="All" mat.occno=1 x.val=12) outfile="vb_vth.dat"
extract name="n_vth" curve(depth, impurity="Electron Conc" material="All" mat.occno=1 x.val=12) outfile="n_vth.dat"
extract name="qfn_vth" curve(depth, impurity="Electron QFL" material="All" mat.occno=1 x.val=12) outfile="qfn_vth.dat"
extract init infile="final.str"
extract name="cb_on" curve(depth, impurity="Conduction Band Energy" material="All" mat.occno=1 x.val=12) outfile="cb_on.dat"
extract name="vb_on" curve(depth, impurity="Valence Band Energy" material="All" mat.occno=1 x.val=12) outfile="vb_on.dat"
extract name="n_on" curve(depth, impurity="Electron Conc" material="All" mat.occno=1 x.val=12) outfile="n_on.dat"
extract name="qfn_on" curve(depth, impurity="Electron QFL" material="All" mat.occno=1 x.val=12) outfile="qfn_on.dat"
quit
