#==============================================================================
# IWO (~2 at.% W:In2O3) FET, channel t = 2.0 nm  --  IWO_PHYSICS_CONSTRAINED_MODEL_V1
# Generated by scripts/build_iwo_decks.py from config/iwo_material_model.yaml (ONE material model for all
# thicknesses). Reduced electrical deck: ideal TiN gate / Pd S/D boundaries (equipotential metals, DC).
# MESH WIDTH = 1 um -> currents are A/um. Total 290-um device current = 290 x logged current. Never divide by 290.
# Cox = 8.9554e-07 F/cm^2 (HfO2 15 nm eps 19.57 + Al2O3 2 nm eps 9.0). Vd = 0.7 V, T = 300.0 K.
# Category labels: A intrinsic, B confinement, D bulk defects, E interface, F transport, G contacts, H numerical.
#==============================================================================
# [A] Eg_bulk = 3.05 eV | LITERATURE_IWO | Fan2021_Nanomaterials Sec.3 (different sputtered IWO device)
# [B] dEg_QC(t) = 0.3533 eV | DFT_PURE_IN2O3_PROXY | a*t^-p, a=0.9205, p=1.3815 (Lin2022 slabs, Si2021)
# [A+B] EG300 = 3.4033 eV | CALCULATED | Eg_bulk + dEg_QC(t)
# [A] chi_bulk = 4.3 eV | LITERATURE_IWO | Fan2021_Nanomaterials Sec.3 (composition-mixing estimate)
# [A+B] AFFINITY = 3.9467 eV | CALCULATED | chi_bulk - dEc(t), dEc = dEg (Ev unchanged, Si2021)
# [A+B] m* = 0.2573 m0 | MEASURED_RELATED_MATERIAL + DFT_PURE_IN2O3_PROXY increment | Stokey2021 bulk 0.208 + Lin2022 PBE increment
# [A+B] NC300 = 3.2744e+18 cm^-3 | CALCULATED | 2(2 pi m* kT/h^2)^1.5; effective continuum DOS at 2 nm
# [A] NV300 = 1.000e+19 cm^-3 | ASSUMED | holes not solved
# [A] PERMITTIVITY = 9.3 - | MEASURED_TARGET_DEVICE | Januar2026 SI Fig.S1 (C-V, IWO 9.30+/-0.04; not bundled, recorded by Astra)
# [D] Nt(t) = 2.0000e+19 cm^-3 | FITTED (anchor from real-ATLAS 2 nm fit: NTA*WTA) consistent with LITERATURE_IWO trend (Januar: ~4x from 13.2 to 2 nm; 5.3e19 at 2 nm with theta_t convention) | Nt2*(2/t)^alpha, Nt2=2e+19, alpha=0.75
# [D] NTA = Nt/WTA = 5.0000e+20 cm^-3/eV | CALCULATED | gTA(E)=NTA exp((E-Ec)/WTA); integral = NTA*WTA*(1-exp(-Eg/WTA))
# [D] WTA (kTt) = 0.04 eV | FITTED, shared across thickness | Tt = 464 K; shared across thickness
# [D] deep acceptor Gaussian = 5e+16 at Ec-0.6 eV, W=0.15 cm^-3/eV | ASSUMED (insensitive; Fan2021 range 2.5-3.7e16 for a different device) | 
# [D] Nd_eff(t) = 2.5002e+17 cm^-3 | FITTED law (effective electrically active background donor density, NOT W concentration) | Nd0*(1+(t/tc)^k), Nd0=2.5e+17, tc=20.0 nm, k=4.0; NOT W concentration
# [E] interface acceptor sheet = 3e+11 at Ec-0.3 eV, W=0.12 eV cm^-2/eV | ASSUMED, shared across thickness; literature Dit(HfO2/In2O3) ~6e11 cm^-2/eV (LITERATURE_IN2O3_PROXY; here IWO/Al2O3) | regularized 0.25 nm IWO layer at the Al2O3 interface: volume amplitude = sheet peak / 0.25 nm (numerically verified: layer /2 changes Id by 0.009 dec)
# [E] Qf = 1.7300e+12 cm^-2 | FITTED single shared value (stage 3); classified as effective electrostatic correction | dVfb = -q Qf/Cox = -0.3095 V
# [F] mu_band(t) = 17.69 cm^2/Vs | FITTED per thickness | FITTED per thickness (no defensible law; sigmoidal trend attributed to percolation/crystallinity, hypothesis)
# [F] roughness factor = 0.7336 - | LITERATURE_IWO (Januar2026 Fig.5f, 2.87 A) | (1 - Dsr/t)^2, Dsr = 0.287 nm
# [F] MUN = mu_band*(1-Dsr/t)^2 = 12.9772 cm^2/Vs | CALCULATED | NOT inserted natively: ATLAS 5.28.1.R ignores MOBILITY updates between SOLVEs (Claude run_0008); the free/trapped partition of Eq.(5) is produced self-consistently by the DOS occupancy; the Ando roll-off theta_r*Vov is an approximation gap (see LIMITATIONS)
# [G] gate work function = 4.7 eV | ASSUMED (TiN 4.5-4.9 eV literature range); degenerate with Qf and chi -> held fixed | 
# [G] S/D = ideal Ohmic (no workfunction)  | ASSUMED; underconstrained (no TLM); CNL above Ec in In2O3 supports low-barrier contacts (Si2021/Lin2022) | 
# [H] capture cross sections = 1e-15 cm^2 | ASSUMED | not identifiable from DC transfer curves
#==============================================================================
go atlas
mesh width=1.0
x.mesh loc=0 spac=0.3
x.mesh loc=3.8 spac=0.05
x.mesh loc=4 spac=0.01
x.mesh loc=4.2 spac=0.05
x.mesh loc=5 spac=0.2
x.mesh loc=14 spac=0.7
x.mesh loc=23 spac=0.2
x.mesh loc=23.8 spac=0.05
x.mesh loc=24 spac=0.01
x.mesh loc=24.2 spac=0.05
x.mesh loc=28 spac=0.3
y.mesh loc=-0.072 spac=0.02
y.mesh loc=-0.002 spac=0.00025
y.mesh loc=-0.00025 spac=6.25e-05
y.mesh loc=-0.000125 spac=6.25e-05
y.mesh loc=0 spac=6.25e-05
y.mesh loc=0.002 spac=0.00025
y.mesh loc=0.017 spac=0.001
y.mesh loc=0.067 spac=0.02
region num=1 user.material=IWO x.min=0 x.max=28 y.min=-0.002 y.max=-0.00025
region num=2 user.material=IWO x.min=0 x.max=28 y.min=-0.00025 y.max=0
# Physical stack of the measured device (bottom gate): TiN 50 nm / HfO2 15 nm / Al2O3 2 nm / IWO / Pd 70 nm S/D, air above the channel.
# TiN is not in the ATLAS metal table: the gate is a Conductor volume whose work function is set on CONTACT (4.70 eV, ASSUMED).
region num=3 material=Al2O3 x.min=0 x.max=28 y.min=0 y.max=0.002
region num=4 material=HfO2 x.min=0 x.max=28 y.min=0.002 y.max=0.017
region num=6 material=Conductor x.min=0 x.max=28 y.min=0.017 y.max=0.067
region num=7 material=Air x.min=0 x.max=28 y.min=-0.072 y.max=-0.002
electrode name=gate x.min=0 x.max=28 y.min=0.017 y.max=0.067
# Pd S/D volumes on the IWO top surface. No CONTACT work function is set for them -> Ohmic boundary (ASSUMED, no TLM data);
# the 2 nm run of this structure is compared with the reduced-boundary deck (run_0008) to verify electrical equivalence.
electrode name=source material=Palladium x.min=0 x.max=4 y.min=-0.072 y.max=-0.002
electrode name=drain material=Palladium x.min=24 x.max=28 y.min=-0.072 y.max=-0.002
doping uniform n.type conc=2.50025e+17 region=1
doping uniform n.type conc=2.50025e+17 region=2
# USER.DEFAULT=silicon is only the parser template; every relevant parameter is overridden above.
material material=IWO user.group=semiconductor user.default=silicon \
 eg300=3.40331 affinity=3.94669 permittivity=9.3 \
 nc300=3.27444e+18 nv300=1e+19 \
 mun=12.9772 mup=0.01 \
 taun0=1e-06 taup0=1e-06
# Region 3 = Al2O3 (2 nm), eps 9.0 (ASSUMED (not reported)); region 4 = HfO2 (15 nm), eps 19.57 (MEASURED_TARGET_DEVICE (SI Fig.S1)).
# Set explicitly for the named materials too: ATLAS built-in permittivity defaults are NOT the measured values.
material region=3 permittivity=9.0
material region=4 permittivity=19.57
contact name=gate workfunction=4.7
models fermi srh temp=300 print
# Region 1: continuous DOS. NTA cm^-3/eV at Ec (tail intercept), WTA eV; NGA/NGD Gaussian amplitudes cm^-3/eV;
#   EGA measured from Ec, EGD measured from Ev (installed manual, DEFECTS statement).
defects region=1 continuous numa=384 numd=192 \
 nta=5e+20 wta=0.04 ntd=0 wtd=0.1 \
 nga=5e+16 ega=0.6 wga=0.15 \
 ngd=0 egd=3.30331 wgd=0.1 \
 sigtae=1e-15 sigtah=1e-15 sigtde=1e-15 sigtdh=1e-15 \
 siggae=1e-15 siggah=1e-15 siggde=1e-15 siggdh=1e-15 \
 afile=acceptor_r1.dat dfile=donor_r1.dat
# Region 2: continuous DOS. NTA cm^-3/eV at Ec (tail intercept), WTA eV; NGA/NGD Gaussian amplitudes cm^-3/eV;
#   EGA measured from Ec, EGD measured from Ev (installed manual, DEFECTS statement).  Interface sheet regularized: NGA = sheet peak / layer thickness.
defects region=2 continuous numa=384 numd=192 \
 nta=5e+20 wta=0.04 ntd=0 wtd=0.1 \
 nga=1.16757e+19 ega=0.301554 wga=0.123975 \
 ngd=0 egd=3.30331 wgd=0.1 \
 sigtae=1e-15 sigtah=1e-15 sigtde=1e-15 sigtdh=1e-15 \
 siggae=1e-15 siggah=1e-15 siggde=1e-15 siggdh=1e-15 \
 afile=acceptor_r2.dat dfile=donor_r2.dat
interface qf=1.73e+12 x.min=0 x.max=28 y.min=-0.0000001 y.max=0.0000001
# Strict acceptance (XANDRNORM, cr.toler 1e-17) up to Vg = 0.7 V; default acceptance above.
method newton trap maxtraps=10 itlimit=80 climit=1e-6 ir.tol=1e-19 \
 cr.toler=1e-17 xandrnorm carriers=1 electrons
output con.band val.band e.mobility
# Interior probes (channel centre) for mobility / free-electron exports vs Vg (native solver quantities).
probe name=chan_mob x=14 y=-0.001 n.mob dir=0
probe name=chan_n x=14 y=-0.001 n.conc
probe name=avg_n region=1 average n.conc x.min=4 x.max=24 y.min=-0.002 y.max=-0.00025
solve init
save outf=equilibrium.str
# Bias ramp to the sweep start with stepped SOLVE blocks (no per-point statements).
solve vstep=-0.1 vfinal=-3 name=gate
solve vstep=0.1 vfinal=0.7 name=drain
log outf=transfer.log
# Stepped sweep (end V, step V): (-1, 0.2), (1.5, 0.05), (3, 0.1) - scored at the solved points only.
solve vgate=-3 vstep=0.2 vfinal=-1 name=gate
solve vstep=0.05 vfinal=0.7 name=gate
save outf=near_vth.str
# On-state: default convergence acceptance.
method newton trap maxtraps=10 itlimit=80 climit=1e-6 ir.tol=1e-19 \
 cr.toler=5e-18 ^xandrnorm carriers=1 electrons
solve vstep=0.05 vfinal=1.5 name=gate
solve vstep=0.1 vfinal=3 name=gate
log off
save outf=final.str
output con.band val.band qfn e.mobility
extract init infile="transfer.log"
extract name="IdVg" curve(v."gate",i."drain") outfile="idvg.dat"
extract name="IgVg" curve(v."gate",i."gate") outfile="igvg.dat"
extract name="IsVg" curve(v."gate",i."source") outfile="isvg.dat"
extract name="mob_vg" curve(v."gate",probe."chan_mob") outfile="chan_mobility_vg.dat"
extract name="n_vg" curve(v."gate",probe."chan_n") outfile="chan_electrons_vg.dat"
extract name="navg_vg" curve(v."gate",probe."avg_n") outfile="avg_electrons_vg.dat"
extract init infile="equilibrium.str"
extract name="cb_eq" curve(depth, impurity="Conduction Band Energy" material="All" mat.occno=1 x.val=14) outfile="cb_eq.dat"
extract name="vb_eq" curve(depth, impurity="Valence Band Energy" material="All" mat.occno=1 x.val=14) outfile="vb_eq.dat"
extract name="n_eq" curve(depth, impurity="Electron Conc" material="All" mat.occno=1 x.val=14) outfile="n_eq.dat"
extract name="qfn_eq" curve(depth, impurity="Electron QFL" material="All" mat.occno=1 x.val=14) outfile="qfn_eq.dat"
extract init infile="near_vth.str"
extract name="cb_vth" curve(depth, impurity="Conduction Band Energy" material="All" mat.occno=1 x.val=14) outfile="cb_vth.dat"
extract name="vb_vth" curve(depth, impurity="Valence Band Energy" material="All" mat.occno=1 x.val=14) outfile="vb_vth.dat"
extract name="n_vth" curve(depth, impurity="Electron Conc" material="All" mat.occno=1 x.val=14) outfile="n_vth.dat"
extract name="qfn_vth" curve(depth, impurity="Electron QFL" material="All" mat.occno=1 x.val=14) outfile="qfn_vth.dat"
extract init infile="final.str"
extract name="cb_on" curve(depth, impurity="Conduction Band Energy" material="All" mat.occno=1 x.val=14) outfile="cb_on.dat"
extract name="vb_on" curve(depth, impurity="Valence Band Energy" material="All" mat.occno=1 x.val=14) outfile="vb_on.dat"
extract name="n_on" curve(depth, impurity="Electron Conc" material="All" mat.occno=1 x.val=14) outfile="n_on.dat"
extract name="qfn_on" curve(depth, impurity="Electron QFL" material="All" mat.occno=1 x.val=14) outfile="qfn_on.dat"
quit
