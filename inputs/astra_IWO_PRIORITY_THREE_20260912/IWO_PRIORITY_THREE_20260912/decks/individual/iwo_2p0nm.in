go atlas
title IWO 2 nm - independent rebuild - uncalibrated
# Units: um. Geometry fixed by the target; electronic parameters are hypotheses.
# n+Si support is screened by ideal TiN and excluded from this electrical domain.
# Physical stack: n+Si / TiN50 / HfO2 15 / Al2O3 2 / IWO / Pd70 nm.
# Air above the exposed channel; no artificial SiO2 overlayer.
# Width-one currents are A/um. Physical device total current is 290 times that.

# 1. Direct rectangular mesh; no imported process mesh.
mesh width=1
x.mesh loc=0 spac=0.5
x.mesh loc=1.8 spac=0.1
x.mesh loc=2 spac=0.05
x.mesh loc=2.2 spac=0.1
x.mesh loc=12 spac=0.5
x.mesh loc=21.8 spac=0.1
x.mesh loc=22 spac=0.05
x.mesh loc=22.2 spac=0.1
x.mesh loc=24 spac=0.5
y.mesh loc=-0.072 spac=0.015
y.mesh loc=-0.022 spac=0.005
y.mesh loc=-0.004 spac=0.001
y.mesh loc=-0.002 spac=0.00025
y.mesh loc=-0.00175 spac=0.00025
y.mesh loc=-0.0015 spac=0.00025
y.mesh loc=-0.00125 spac=0.00025
y.mesh loc=-0.001 spac=0.00025
y.mesh loc=-0.00075 spac=0.00025
y.mesh loc=-0.0005 spac=0.00025
y.mesh loc=-0.00025 spac=0.00025
y.mesh loc=0 spac=0.00025
y.mesh loc=0.0005 spac=0.0005
y.mesh loc=0.001 spac=0.0005
y.mesh loc=0.0015 spac=0.0005
y.mesh loc=0.002 spac=0.0005
y.mesh loc=0.0035 spac=0.0015
y.mesh loc=0.005 spac=0.0015
y.mesh loc=0.0065 spac=0.0015
y.mesh loc=0.008 spac=0.0015
y.mesh loc=0.0095 spac=0.0015
y.mesh loc=0.011 spac=0.0015
y.mesh loc=0.0125 spac=0.0015
y.mesh loc=0.014 spac=0.0015
y.mesh loc=0.0155 spac=0.0015
y.mesh loc=0.017 spac=0.0015
y.mesh loc=0.067 spac=0.01

# 2. Active stack and physical metal volumes.
region num=1 material=Air y.min=-0.072 y.max=-0.002
region num=2 user.material=IWO y.min=-0.002 y.max=0
region num=3 material=Al2O3 y.min=0 y.max=0.002
region num=4 material=HfO2 y.min=0.002 y.max=0.017
region num=5 material=Conductor y.min=0.017 y.max=0.067
electrode num=1 name=gate material=Conductor x.min=0 x.max=24 y.min=0.017 y.max=0.067
electrode num=2 name=source material=Palladium x.min=0 x.max=2 y.min=-0.072 y.max=-0.002
electrode num=3 name=drain material=Palladium x.min=22 x.max=24 y.min=-0.072 y.max=-0.002

# 3. Custom IWO; unlisted inherited constants remain a limitation.
material material=IWO user.group=semiconductor user.default=silicon \
 eg300=3.05 affinity=4.3 permittivity=9.3 \
 nc300=5e+18 nv300=1e+19 \
 mun=13.3 mup=0.01 \
 taun0=1e-06 taup0=1e-06
material material=Al2O3 permittivity=9
material material=HfO2 permittivity=19.57
material material=Air permittivity=1
doping uniform n.type conc=2e+17 region=2

# 4. Native electrical boundary conditions.
contact name=gate workfunction=4.765
contact name=source workfunction=4.45 surf.rec
contact name=drain workfunction=4.45 surf.rec
models srh fermi temp=300 print

# 5. Native bulk DOS: peak cm^-3/eV; donor center referenced to Ev.
defects region=2 continuous numa=384 numd=192 \
 nta=5.5e+20 wta=0.04 ntd=0 wtd=0.1 \
 nga=0 ega=0.3 wga=0.15 \
 ngd=0 egd=2.85 wgd=0.1 \
 sigtae=1e-15 sigtah=1e-15 sigtde=1e-15 sigtdh=1e-15 \
 siggae=1e-15 siggah=1e-15 siggde=1e-15 siggdh=1e-15 \
 afile=iwo_2p0nm_bulk_acceptor.dat dfile=iwo_2p0nm_bulk_donor.dat

# 7. Numerical controls and independent interior-point diagnostics.
method newton carriers=1 electrons trap maxtrap=10 itlimit=60 climit=1e-6 cr.toler=1e-20 ir.tol=1e-20 cx.toler=1e-6
output con.band val.band e.mobility traps traps.ft int.charge charge
probe name=channel_mobility x=12.037 y=-0.00094 n.mob dir=0
probe name=channel_electrons x=12.037 y=-0.00094 n.conc
probe name=bulk_free_electrons region=2 average n.conc x.min=2 x.max=22 y.min=-0.002 y.max=0
probe name=bulk_ionized_acceptors region=2 average concacc.ctrap x.min=2 x.max=22 y.min=-0.002 y.max=0
probe name=bulk_ionized_donors region=2 average concdon.ctrap x.min=2 x.max=22 y.min=-0.002 y.max=0
save outf=iwo_2p0nm_geometry.str
solve init
save outf=iwo_2p0nm_equilibrium.str
solve vsource=0
solve vgate=-0.1
solve vgate=-0.2
solve vgate=-0.3
solve vgate=-0.4
solve vgate=-0.5
solve vgate=-0.6
solve vgate=-0.7
solve vgate=-0.8
solve vgate=-0.9
solve vgate=-1
solve vgate=-1.1
solve vgate=-1.2
solve vgate=-1.3
solve vgate=-1.4
solve vgate=-1.5
solve vgate=-1.6
solve vgate=-1.7
solve vgate=-1.8
solve vgate=-1.9
solve vgate=-2
solve vgate=-2.1
solve vgate=-2.2
solve vgate=-2.3
solve vgate=-2.4
solve vgate=-2.5
solve vgate=-2.6
solve vgate=-2.7
solve vgate=-2.8
solve vgate=-2.9
solve vgate=-3
solve vdrain=0.1
solve vdrain=0.2
solve vdrain=0.3
solve vdrain=0.4
solve vdrain=0.5
solve vdrain=0.6
solve vdrain=0.7
save outf=iwo_2p0nm_off.str

# 8. Every original gate point; fresh signed terminal exports.
log outf=iwo_2p0nm_transfer.log
solve vgate=-3
solve vgate=-2.95
solve vgate=-2.9
solve vgate=-2.85
solve vgate=-2.8
solve vgate=-2.75
solve vgate=-2.7
solve vgate=-2.65
solve vgate=-2.6
solve vgate=-2.55
solve vgate=-2.5
solve vgate=-2.45
solve vgate=-2.4
solve vgate=-2.35
solve vgate=-2.3
solve vgate=-2.25
solve vgate=-2.2
solve vgate=-2.15
solve vgate=-2.1
solve vgate=-2.05
solve vgate=-2
solve vgate=-1.95
solve vgate=-1.9
solve vgate=-1.85
solve vgate=-1.8
solve vgate=-1.75
solve vgate=-1.7
solve vgate=-1.65
solve vgate=-1.6
solve vgate=-1.55
solve vgate=-1.5
solve vgate=-1.45
solve vgate=-1.4
solve vgate=-1.35
solve vgate=-1.3
solve vgate=-1.25
solve vgate=-1.2
solve vgate=-1.15
solve vgate=-1.1
solve vgate=-1.05
solve vgate=-1
solve vgate=-0.95
solve vgate=-0.9
solve vgate=-0.85
solve vgate=-0.8
solve vgate=-0.75
solve vgate=-0.7
solve vgate=-0.65
solve vgate=-0.6
solve vgate=-0.55
solve vgate=-0.5
solve vgate=-0.45
solve vgate=-0.4
solve vgate=-0.35
solve vgate=-0.3
solve vgate=-0.25
solve vgate=-0.2
solve vgate=-0.15
solve vgate=-0.1
solve vgate=-0.05
solve vgate=0
solve vgate=0.05
solve vgate=0.1
solve vgate=0.15
solve vgate=0.2
solve vgate=0.25
solve vgate=0.3
solve vgate=0.35
solve vgate=0.4
solve vgate=0.45
solve vgate=0.5
solve vgate=0.55
solve vgate=0.6
solve vgate=0.65
solve vgate=0.7
solve vgate=0.75
solve vgate=0.8
solve vgate=0.85
solve vgate=0.9
solve vgate=0.95
solve vgate=1
solve vgate=1.05
solve vgate=1.1
solve vgate=1.15
solve vgate=1.2
solve vgate=1.25
solve vgate=1.3
solve vgate=1.35
solve vgate=1.4
solve vgate=1.45
solve vgate=1.5
solve vgate=1.55
solve vgate=1.6
solve vgate=1.65
solve vgate=1.7
solve vgate=1.75
solve vgate=1.8
solve vgate=1.85
solve vgate=1.9
solve vgate=1.95
solve vgate=2
solve vgate=2.05
solve vgate=2.1
solve vgate=2.15
solve vgate=2.2
solve vgate=2.25
solve vgate=2.3
solve vgate=2.35
solve vgate=2.4
solve vgate=2.45
solve vgate=2.5
solve vgate=2.55
solve vgate=2.6
solve vgate=2.65
solve vgate=2.7
solve vgate=2.75
solve vgate=2.8
solve vgate=2.85
solve vgate=2.9
solve vgate=2.95
solve vgate=3
log off
save outf=iwo_2p0nm_final.str
extract init infile="iwo_2p0nm_transfer.log"
extract name="idvg" curve(v."gate",i."drain") outfile="iwo_2p0nm_idvg.dat"
extract name="isvg" curve(v."gate",i."source") outfile="iwo_2p0nm_isvg.dat"
extract name="igvg" curve(v."gate",i."gate") outfile="iwo_2p0nm_igvg.dat"
extract name="vdvg" curve(v."gate",v."drain") outfile="iwo_2p0nm_vdvg.dat"
extract name="vsvg" curve(v."gate",v."source") outfile="iwo_2p0nm_vsvg.dat"
extract name="mobility_vg" curve(v."gate",probe."channel_mobility") outfile="iwo_2p0nm_mobility_vg.dat"
extract name="electrons_vg" curve(v."gate",probe."channel_electrons") outfile="iwo_2p0nm_electrons_vg.dat"
extract name="bulk_free_electrons_vg" curve(v."gate",probe."bulk_free_electrons") outfile="iwo_2p0nm_bulk_free_electrons_vg.dat"
extract name="bulk_ionized_acceptors_vg" curve(v."gate",probe."bulk_ionized_acceptors") outfile="iwo_2p0nm_bulk_ionized_acceptors_vg.dat"
extract name="bulk_ionized_donors_vg" curve(v."gate",probe."bulk_ionized_donors") outfile="iwo_2p0nm_bulk_ionized_donors_vg.dat"
# Delivery UI: show each native saved structure and transfer log.
tonyplot iwo_2p0nm_geometry.str
tonyplot iwo_2p0nm_equilibrium.str
tonyplot iwo_2p0nm_off.str
tonyplot iwo_2p0nm_transfer.log
tonyplot iwo_2p0nm_final.str
quit
