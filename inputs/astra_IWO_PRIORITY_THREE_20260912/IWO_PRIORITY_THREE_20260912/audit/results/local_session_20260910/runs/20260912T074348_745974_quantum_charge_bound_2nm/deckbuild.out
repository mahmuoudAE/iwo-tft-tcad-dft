ATLAS> 
ATLAS> # 7. Charge-only diagnostic; one ATLAS engine, two model phases.
ATLAS> # Seed: config/rebuild_contact_electron.json. Both trap families are OFF.
ATLAS> # The same 32-interval IWO mesh and same input physics are used in both phases.
ATLAS> # MC=0.34*m0 is an explicit single-parabolic-band prior, approximately consistent
ATLAS> # with NC300=5e18 cm^-3 at 300K, not an independently measured IWO mass.
ATLAS> # Hard-wall quantum phase disallows insulator penetration (^OX.SCHRO).
ATLAS> # This is a confinement bound, not finite-barrier calibration or atomistic IWO.
ATLAS> material region=2 mc=0.34 ml=0.34 mt1=0.34 mt2=0.34
ATLAS> models srh fermi temp=300 ^schrodinger ^p.schro ^bqp.n ^bqp.p print
ATLAS> method newton carriers=0 trap maxtrap=10 itlimit=60 climit=1e-6 cr.toler=1e-20 ir.tol=1e-20 cx.toler=1e-6


