ATLAS> # 9. Self-consistent electron Schrodinger-Poisson phase: reinitialize.
ATLAS> # SP.GEOMETRY=1DY selects the documented y slice; NUM.DIRECT=1 is one isotropic valley.
ATLAS> # FIXED.FERMI sets the quantum Fermi level to zero, consistent with VS=VD=0.
ATLAS> # QMINCONC is a numerical density floor in cm^-3, not a leakage-current model.
ATLAS> # SP.NUMITER is bounded; reaching a bias target alone does not prove SP convergence.
ATLAS> models srh fermi temp=300 schrodinger num.direct=1 sp.geometry=1dy eigens=8 fixed.fermi ^calc.fermi ^ox.schro ^post.schro ^bqp.n ^bqp.p qminconc=1e-10 qcrit.negf=1e-4 print

